# ============================================================================
# 本仓库会公开 —— 以下每一项都是「一旦推上去就洗不掉」的内容
# ============================================================================

# 🔴 真实账户数据：持仓明细、净值、浮盈亏、权重、集中度
data/
outbox/

# 🔴 运行日志（含账户数字与持仓代码）
logs/
*.log

# 🔴 运行态（推送历史、去重指纹）
state.json
state.tmp

# 🔴 密钥（本项目实际把 .env 放在 vault 外，这里再兜一层）
.env
*.env
!.env.example

# 🔴 你的真实配置（自选股、阈值）—— 只推 config.example.yaml
config.yaml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
